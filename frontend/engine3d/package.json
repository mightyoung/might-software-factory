{
  "name": "@might/engine-3d",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test schema/*.test.ts core/*.test.ts sim/*.test.ts",
    "build": "npm run typecheck && vite build",
    "check:bundle": "node check-bundle.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "three": "0.187.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
