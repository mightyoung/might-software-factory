{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["core/**/*.ts", "runtime/**/*.ts", "schema/**/*.ts", "sim/**/*.ts", "player/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
