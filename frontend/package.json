{
  "name": "might-software-factory-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix office --ignore-scripts --no-audit --no-fund",
    "build:office": "npm run build --prefix office",
    "prebuild": "npm run build:office",
    "predev": "npm run build:office",
    "dev": "vite --host 127.0.0.1",
    "mock": "node tools/mock-server/server.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "gen:api": "npm ci --prefix tools/api-types --no-audit --no-fund && node tools/api-types/generate.mjs",
    "check:api": "npm ci --prefix tools/api-types --no-audit --no-fund && node tools/api-types/generate.mjs --check",
    "e2e": "playwright test",
    "check:bundle": "node tools/check-bundle-size.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "terser": "5.51.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
