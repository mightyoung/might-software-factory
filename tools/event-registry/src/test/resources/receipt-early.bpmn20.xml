<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn" targetNamespace="ledger-fixture">
    <process id="receiptWithIntake" isExecutable="true">
        <startEvent id="start"/>
        <sequenceFlow sourceRef="start" targetRef="intake"/>
        <userTask id="intake" name="接收资料"/>
        <sequenceFlow sourceRef="intake" targetRef="waitForBatch"/>
        <intermediateCatchEvent id="waitForBatch">
            <extensionElements>
                <flowable:eventType>batchApproved</flowable:eventType>
                <flowable:eventCorrelationParameter name="instance" value="${execution.processInstanceId}"/>
                <flowable:eventCorrelationParameter name="batch" value="${batch}"/>
            </extensionElements>
        </intermediateCatchEvent>
        <sequenceFlow sourceRef="waitForBatch" targetRef="received"/>
        <userTask id="received" name="核对验收记录"/>
        <sequenceFlow sourceRef="received" targetRef="done"/>
        <endEvent id="done"/>
    </process>
</definitions>
