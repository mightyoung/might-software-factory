<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mightyoung</groupId>
        <artifactId>might-software-factory</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>backend</artifactId>
    <name>Might Software Factory Backend</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>
        <!-- The starter already supplies these exact BOM-managed artifacts at runtime.
             Root composition uses their public repository/settings APIs at compile time. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-codegen</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>3.0.8</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>lan-postgres-compatibility</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>add-lan-compatibility-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                    <goal>add-test-resource</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/integration-test/java</source>
                                    </sources>
                                    <resources>
                                        <resource>
                                            <directory>src/integration-test/resources</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <!-- Compile Failsafe *IT sources and shared test fixtures in this profile. -->
                            <testIncludes>
                                <testInclude>**/*.java</testInclude>
                            </testIncludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ci-pg18-risk-capture</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>add-ci-pg18-capture-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal><goal>add-test-resource</goal></goals>
                                <configuration>
                                    <sources><source>src/ci-pg18-test/java</source></sources>
                                    <resources><resource><directory>src/ci-pg18-test/resources</directory></resource></resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration><testIncludes><testInclude>**/*.java</testInclude></testIncludes></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes><include>**/CiPg18CaptureTargetTest.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <includes><include>**/RiskChangeCapturePostgresIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <rerunFailingTestsCount>0</rerunFailingTestsCount>
                        </configuration>
                        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ci-pg18-risk-registry</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>add-ci-pg18-registry-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal><goal>add-test-resource</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>src/ci-pg18-test/java</source>
                                        <source>src/ci-pg18-registry-test/java</source>
                                    </sources>
                                    <resources>
                                        <resource><directory>src/ci-pg18-test/resources</directory></resource>
                                        <resource><directory>src/ci-pg18-registry-test/resources</directory></resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration><testIncludes><testInclude>**/*.java</testInclude></testIncludes></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes><include>**/CiPg18RegistryTargetTest.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <includes><include>**/RiskNativePublicationPostgresIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <rerunFailingTestsCount>0</rerunFailingTestsCount>
                        </configuration>
                        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ci-pg18-risk-source</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>add-ci-pg18-source-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal><goal>add-test-resource</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>src/ci-pg18-test/java</source>
                                        <source>src/ci-pg18-source-test/java</source>
                                    </sources>
                                    <resources>
                                        <resource><directory>src/ci-pg18-test/resources</directory></resource>
                                        <resource><directory>src/ci-pg18-source-test/resources</directory></resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration><testIncludes><testInclude>**/*.java</testInclude></testIncludes></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes><include>**/CiPg18SourceTargetTest.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <includes><include>**/CiPg18RiskSourceIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <rerunFailingTestsCount>0</rerunFailingTestsCount>
                        </configuration>
                        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ci-pg18-risk-recovery</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>add-ci-pg18-recovery-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal><goal>add-test-resource</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>src/ci-pg18-test/java</source>
                                        <source>src/ci-pg18-source-test/java</source>
                                        <source>src/ci-pg18-recovery-test/java</source>
                                    </sources>
                                    <resources>
                                        <resource><directory>src/ci-pg18-test/resources</directory></resource>
                                        <resource><directory>src/ci-pg18-source-test/resources</directory></resource>
                                        <resource><directory>src/ci-pg18-recovery-test/resources</directory></resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration><testIncludes><testInclude>**/*.java</testInclude></testIncludes></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes><include>**/CiPg18RecoveryTargetTest.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <includes><include>**/CiPg18RecoveryPostgresIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <rerunFailingTestsCount>0</rerunFailingTestsCount>
                        </configuration>
                        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
